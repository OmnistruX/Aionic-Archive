# GEMINI_API_KEY: Optional server-side key for Google Gemini multimodal analysis (gemini-4-hydrogen) and speech transcription (gemini-3.5-transcribe).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AAI_ALLOW_CLOUD_AI: Hard deployment approval gate for remote/paid cloud AI calls.
# Keep "false" pending explicit approval; set "true" only when remote cloud processing is authorized.
AAI_ALLOW_CLOUD_AI="false"

# OPENAI_API_KEY: Optional server-side key for OpenAI multimodal provider adapter.
OPENAI_API_KEY=""

# AZURE_AI_API_KEY & AZURE_AI_ENDPOINT: Optional server-side credentials for Azure AI Vision/OpenAI adapter.
AZURE_AI_API_KEY=""
AZURE_AI_ENDPOINT=""

# AAI_DATA_DIR: Optional local directory for SQLite database, vault originals, extracted audio, and keyframes.
AAI_DATA_DIR="./data"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
